DATABASE_URL=postgres://user:password@localhost:5432/dbname
SALON_ID=salon-name
NEXT_PUBLIC_LOCALES=es,en
NEXT_PUBLIC_DEFAULT_LOCALE=es
SALON_WHATSAPP=34600000000
# Fotos: "local" (desarrollo, guarda en public/uploads) o "r2" (Cloudflare R2)
STORAGE_DRIVER=local
# Solo con r2:
STORAGE_PUBLIC_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Dirección pública de la web, sin barra final (enlaces de los correos). En producción: https://...
APP_URL=
# Correos: "console" (desarrollo: se escriben en la terminal) o "resend"
EMAIL_DRIVER=console
# Solo con resend:
RESEND_API_KEY=
EMAIL_FROM=
# Opcional: a dónde responde la clienta (por defecto, el email de contacto del salón)
EMAIL_REPLY_TO=
# Secreto para el recordatorio automático (/api/cron/reminders). Genera uno largo, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=